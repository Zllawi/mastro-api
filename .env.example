# Copy this file to .env on your backend server and fill in real values there.
# Never commit .env because it contains secrets.

RESALA_API_TOKEN=replace_with_your_resala_token
RESALA_BASE_URL=https://dev.resala.ly/api/v1

# Supabase project values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_public_anon_key

# Backend-only secrets. Never expose these in Flutter or browser code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Cloudinary is backend-only. Never pass API_SECRET to Flutter or web builds.
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
CLOUDINARY_UPLOAD_FOLDER=maestro

# Firebase Cloud Messaging is backend-only. Download a service-account JSON
# from Firebase Console and keep it outside source control.
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
# For container deployments, use base64 instead of a filesystem path.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# HTTP backend binding.
HOST=0.0.0.0
PORT=8080

# A pre-authorized Libyan phone for the web admin account. The backend creates
# or restores only this admin account; admins cannot be registered publicly.
MAESTRO_ADMIN_PHONE=2189XXXXXXXX

# OTP-free allowlisted accounts for development/staging only. These values are
# read by the backend and must never enable bypasses in production.
MAESTRO_TEST_CUSTOMER_PHONE=218910000001
MAESTRO_TEST_CRAFTSMAN_PHONE=218920000002

# development, staging, or production.
# Non-production environments send OTPs with ?test automatically.
# OTP-free test login can only be toggled from the admin web interface when
# this value is development or staging. It is always blocked in production.
APP_ENV=development
